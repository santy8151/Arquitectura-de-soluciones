@startuml
title LastTrack - Diagrama UML de Contexto

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor Cliente
actor "Operador de comercio\n/ Tienda" as Tienda
actor "Administrador\nde almacén" as Almacen
actor Repartidor
actor "Soporte al cliente" as Soporte

rectangle "Límite del sistema" {
  component "LastTrack\nPlataforma de gestión logística" as LastTrack
}

cloud "Sistema de pagos" as Pagos
cloud "Servicio de\ngeolocalización" as Geo
cloud "Sistema de\nnotificaciones" as Notificaciones
database "ERP / CRM\ninterno" as ERP

Cliente --> LastTrack : Consulta pedido
LastTrack --> Cliente : Estado y trazabilidad

Tienda --> LastTrack : Registra pedido
LastTrack --> Tienda : Estado de operación

Almacen --> LastTrack : Actualiza inventario
LastTrack --> Almacen : Solicitud de preparación

Repartidor --> LastTrack : Ubicación / estado
LastTrack --> Repartidor : Pedido / ruta asignada

Soporte --> LastTrack : Consulta / incidencia
LastTrack --> Soporte : Historial del pedido

LastTrack --> Pagos : Verificar pago
Pagos --> LastTrack : Confirmación

LastTrack --> Geo : Solicitar ruta / ubicación
Geo --> LastTrack : Datos geográficos

LastTrack --> Notificaciones : Enviar evento
Notificaciones --> Cliente : SMS / correo / push

LastTrack --> ERP : Consultar / sincronizar datos
ERP --> LastTrack : Datos internos

@enduml
